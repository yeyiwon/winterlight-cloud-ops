# mock(기본): 시뮬레이션 데이터, 모든 수치에 DEMO 표시
# live: 읽기 전용 어댑터. DASHBOARD_PASSWORD 없이는 시작하지 않는다(503).
DATA_MODE=mock
DASHBOARD_PASSWORD=

# 아래 값은 모두 서버 전용이다. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
WINTERLIGHT_WEB_URL=https://moru-winter-park.vercel.app
# 실시간 Worker 주소는 이 앱이 추측하지 않는다. 원본 저장소의 아래 파일에 기록된 후보:
#   scripts/verify-cloudflare-v46.mjs, qa/*/production/integrity.json → https://winterlight-realtime.winterlight.workers.dev
#   realtime/wrangler.jsonc 의 env.production.name = winterlight-realtime
# 실제 운영 주소와 같은지 `npm run verify:live` 결과(service=winterlight-realtime)로 확인한 뒤 채운다.
WINTERLIGHT_REALTIME_URL=
VERCEL_TOKEN=        # 읽기 전용(Deployments) 토큰
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CF_API_TOKEN=        # Account Analytics:Read 만 부여
CF_ACCOUNT_ID=
CF_WORKER_NAME=
