+// Metrics bearer: compared as SHA-256 digests so the check does not leak length or prefix timing.
+export async function verifyBearer(header,secret){
+ if(!secret||secret.length<32||typeof header!=='string'||!header.startsWith('Bearer ')||header.length>300)return false;
+ const [a,b]=await Promise.all([header.slice(7),secret].map(async v=>new Uint8Array(await crypto.subtle.digest('SHA-256',enc.encode(v)))));let diff=0;for(let i=0;i<a.length;i++)diff|=a[i]^b[i];return diff===0;
